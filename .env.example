# --- Ollama (Windows 네이티브) ---
OLLAMA_HOST=http://127.0.0.1:11434
# qwen3.6:27b (기본) / gpt-oss:20b / qwen3.8:27b (pull 필요)
OLLAMA_MODEL=qwen3.6:27b
# qwen3.6 thinking 모드. 도구 호출 지연을 줄이려면 false 유지
THINK=false

# --- Target site ---
# mock | korail
TARGET_SITE=mock
MOCK_SITE_URL=http://127.0.0.1:8765
KORAIL_URL=https://www.letskorail.com

# --- Playwright ---
# 데모 녹화 시 false 로 바꾸면 브라우저 창이 보입니다
HEADLESS=true
BROWSER_TIMEOUT_MS=15000
SCREENSHOT_DIR=screenshots

# --- MCP 트랜스포트 ---
# stdio (기본, 클라이언트가 서버를 자식 프로세스로 띄움) | http (서버를 먼저 띄워 두고 접속)
MCP_TRANSPORT=stdio
# http 일 때만 사용. 서버: python -m toolsdemo.mcp_.http_server
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8931
MCP_HTTP_PATH=/mcp
# 위 세 값 대신 접속 주소를 통째로 지정하고 싶을 때만 (원격 서버 등)
# MCP_HTTP_URL=http://127.0.0.1:8931/mcp

# --- Agent ---
MAX_TOOL_ITERATIONS=8
LOG_LEVEL=INFO

# --- 실제 코레일 사용 시에만 (절대 커밋 금지) ---
# KORAIL_ID=
# KORAIL_PW=
